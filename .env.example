# VEYRO Production Integration Environment Variables
# Copy to .env.local for local overrides. Never commit actual secret keys.

# Studio Public Contact Points & Production Domain
# Set VITE_REAL_DOMAIN to your live canonical production domain (e.g. https://veyro.studio)
VITE_REAL_DOMAIN=https://veyro.example
VITE_WHATSAPP_NUMBER=919999999999
VITE_BUSINESS_EMAIL=hello.veyro@gmail.com

# Form & Lead Automation Endpoints
VITE_FORM_ENDPOINT=
VITE_GOOGLE_SHEETS_WEBHOOK=
VITE_CRM_ENDPOINT=

# Analytics & Webmaster Verification
VITE_ANALYTICS_ID=
VITE_SEARCH_CONSOLE_VERIFICATION=

# Studio Social Profiles
VITE_SOCIAL_INSTAGRAM=https://instagram.com/veyro.studio
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/veyro
